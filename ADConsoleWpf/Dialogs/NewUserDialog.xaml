<Window x:Class="ADConsole.Dialogs.NewUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Icon="/app.ico"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建域用户"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="380">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名 (CN) *" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="登录名 (≤20字符) *" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="SamBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextChanged="SamBox_TextChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="初始密码 *" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <PasswordBox x:Name="PwdBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
                <Button x:Name="GenBtn" Grid.Row="2" Grid.Column="2" Content="生成强密码"
                        Margin="8,0,0,8" Click="GenBtn_Click"/>

                <CheckBox x:Name="ForceChangeBox" Grid.Row="3" Grid.Column="1"
                          Content="首次登录时必须修改密码" IsChecked="True" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="所在 OU" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <ComboBox x:Name="OuCombo" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                          Margin="0,0,0,8" MaxDropDownHeight="260"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="部门" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="DeptBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="职位" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="TitleBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="邮箱" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="EmailBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="电话" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="PhoneBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="描述" VerticalAlignment="Top" Margin="0,6,10,8"/>
                <TextBox x:Name="DescBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2"
                         Height="52" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,8"/>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="Hint" Grid.Row="1" Foreground="#FFC00000" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkBtn" Content="创建" Width="100" IsDefault="True" Click="OkBtn_Click"/>
            <Button Content="取消" Width="88" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
