<Window x:Class="ADConsole.Dialogs.CsvImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量导入用户 (CSV)"
        Height="620" Width="880"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 文件选择 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="CSV 文件" VerticalAlignment="Center"/>
            <TextBox x:Name="PathBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="浏览…" Click="Browse_Click" Width="80"/>
            <Button Grid.Column="3" Content="解析" Click="Parse_Click" Width="80" Margin="8,0,0,0"/>
        </Grid>

        <!-- 默认 OU -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="默认 OU" VerticalAlignment="Center"/>
            <ComboBox x:Name="OuCombo" Grid.Column="1" MaxDropDownHeight="260" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Text="CSV 未指定 OU 时使用" VerticalAlignment="Center"
                       FontSize="11" Foreground="#FF808080"/>
        </Grid>

        <TextBlock x:Name="StatLine" Grid.Row="2" Margin="0,0,0,6" FontWeight="Bold"/>

        <!-- 预览 / 结果 -->
        <TabControl Grid.Row="3" x:Name="MainTabs">
            <TabItem Header="预览与校验">
                <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="行号" Binding="{Binding LineNo}" Width="50"/>
                        <DataGridTextColumn Header="登录名" Binding="{Binding SamAccountName}" Width="110"/>
                        <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="110"/>
                        <DataGridTextColumn Header="目标 OU" Binding="{Binding OuDn}" Width="230"/>
                        <DataGridTextColumn Header="部门" Binding="{Binding Department}" Width="100"/>
                        <DataGridTextColumn Header="职位" Binding="{Binding Title}" Width="90"/>
                        <DataGridTextColumn Header="邮箱" Binding="{Binding Email}" Width="150"/>
                        <DataGridTextColumn Header="电话" Binding="{Binding Phone}" Width="100"/>
                        <DataGridTextColumn Header="校验" Binding="{Binding ValidationText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="执行结果">
                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="行号" Binding="{Binding LineNo}" Width="60"/>
                        <DataGridTextColumn Header="登录名" Binding="{Binding SamAccountName}" Width="140"/>
                        <DataGridTextColumn Header="结果" Binding="{Binding ResultText}" Width="80"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="Hint" Grid.Row="4" Foreground="#FFC00000" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="#FF808080"
                       Text="支持 UTF-8 与 GBK 编码；表头接受中英文别名，不区分大小写。"/>
            <Button x:Name="ExportFailBtn" DockPanel.Dock="Right" Content="导出失败明细" Width="110"
                    Margin="8,0,0,0" Click="ExportFail_Click" IsEnabled="False"/>
            <Button x:Name="ImportBtn" DockPanel.Dock="Right" Content="开始导入" Width="100"
                    Margin="8,0,0,0" Click="Import_Click" IsEnabled="False"/>
            <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="关闭" Width="80" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
