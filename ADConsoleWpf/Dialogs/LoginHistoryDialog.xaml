<Window x:Class="ADConsole.Dialogs.LoginHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Icon="/app.ico"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录历史查询"
        Height="580" Width="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 查询条件 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="姓名或登录名" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="KeywordBox" Grid.Column="1" VerticalAlignment="Center"
                     KeyDown="KeywordBox_KeyDown"/>
            <CheckBox x:Name="RecursiveBox" Grid.Column="2" Content="递归搜索全域" IsChecked="True"
                      VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button x:Name="QueryBtn" Grid.Column="3" Content="查询" Width="90" Margin="16,0,0,0" Click="Query_Click"/>
            <Button x:Name="EventBtn" Grid.Column="4" Content="查询登录明细" Width="110" Margin="8,0,0,0" Click="Event_Click"/>
        </Grid>

        <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,0,0,6" FontWeight="Bold"/>

        <!-- 结果页 -->
        <TabControl Grid.Row="2" x:Name="MainTabs">
            <TabItem Header="最近登录（精确）">
                <DataGrid x:Name="ExactGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="姓名" Binding="{Binding DisplayNameOrName}" Width="140"/>
                        <DataGridTextColumn Header="登录名" Binding="{Binding SamAccountName}" Width="140"/>
                        <DataGridTextColumn Header="最后登录（精确）" Binding="{Binding LastLogonExact, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/>
                        <DataGridTextColumn Header="来源域控" Binding="{Binding LastLogonServer}" Width="180"/>
                        <DataGridTextColumn Header="近似值(可复制)" Binding="{Binding LastLogonApprox, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="登录明细 (4624)">
                <DataGrid x:Name="EventGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="160"/>
                        <DataGridTextColumn Header="账户" Binding="{Binding Account}" Width="200"/>
                        <DataGridTextColumn Header="来源 IP" Binding="{Binding IpAddress}" Width="130"/>
                        <DataGridTextColumn Header="登录类型" Binding="{Binding LogonType}" Width="130"/>
                        <DataGridTextColumn Header="域控" Binding="{Binding DomainController}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="Hint" Grid.Row="3" Foreground="#FFC00000" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="#FF808080"
                       Text="精确值来自逐台域控读取 lastLogon（该属性不复制）；明细需读取域控安全日志。"/>
            <Button DockPanel.Dock="Right" Content="关闭" Width="80" IsCancel="True" Click="Close_Click"/>
            <Button x:Name="ExportBtn" DockPanel.Dock="Right" Content="导出 CSV" Width="90" Margin="0,0,8,0"
                    Click="Export_Click" IsEnabled="False"/>
        </DockPanel>
    </Grid>
</Window>
