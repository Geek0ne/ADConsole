<Window x:Class="ADConsole.Dialogs.PasswordExpiryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Icon="/app.ico"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码到期提醒"
        Height="560" Width="860"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="提前提醒天数" VerticalAlignment="Center"/>
            <TextBox x:Name="DaysBox" Width="60" Text="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="IncludeExpiredBox" Content="包含已过期" IsChecked="True"
                      VerticalAlignment="Center" Margin="20,0,0,0"/>
            <CheckBox x:Name="IncludeNeverBox" Content="包含密码永不过期的账号"
                      VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button x:Name="QueryBtn" Content="查询" Width="90" Margin="20,0,0,0" Click="Query_Click"/>
            <Button Content="导出 CSV" Width="90" Margin="8,0,0,0" Click="Export_Click"/>
        </StackPanel>

        <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,0,0,6" FontWeight="Bold"/>

        <DataGrid Grid.Row="2" x:Name="ListGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  MouseDoubleClick="ListGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="130"/>
                <DataGridTextColumn Header="登录名" Binding="{Binding SamAccountName}" Width="130"/>
                <DataGridTextColumn Header="密码最后设置" Binding="{Binding PasswordLastSetText}" Width="140"/>
                <DataGridTextColumn Header="到期时间" Binding="{Binding ExpireDateText}" Width="140"/>
                <DataGridTextColumn Header="剩余" Binding="{Binding DaysLeftText}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="所在 OU" Binding="{Binding OuDisplay}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="Hint" Grid.Row="3" Foreground="#FFC00000" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="#FF808080"
                       Text="双击某一行可直接为该账号重置密码（需要写权限）。"/>
            <Button DockPanel.Dock="Right" Content="关闭" Width="80" IsCancel="True" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
