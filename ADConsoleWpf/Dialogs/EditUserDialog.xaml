<Window x:Class="ADConsole.Dialogs.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/app.ico"
        Title="编辑用户属性"
        Height="432" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 只读信息 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBlock x:Name="NameText" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                       FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="登录名" VerticalAlignment="Center" Margin="0,0,10,12"/>
            <TextBlock x:Name="SamText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="#FF606060" Margin="0,0,0,12"/>

            <!-- 可编辑属性 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="部门" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox x:Name="DeptBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                     ToolTip="对应 AD 用户属性「组织 → 部门」(department)"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="职位" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox x:Name="TitleBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                     ToolTip="对应 AD 用户属性「组织 → 职务」(title)"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="邮箱" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox x:Name="EmailBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="电话" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox x:Name="PhoneBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="说明" VerticalAlignment="Top" Margin="0,6,10,8"/>
            <TextBox x:Name="DescBox" Grid.Row="6" Grid.Column="1" Height="72" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                     ToolTip="对应 AD 用户属性「常规 → 描述」(description)"/>
        </Grid>

        <TextBlock x:Name="Hint" Grid.Row="1" Foreground="#FF808080" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="清空某项后保存，会从域中删除该属性值。"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkBtn" Content="保存" Width="100" IsDefault="True" Click="OkBtn_Click"/>
            <Button Content="取消" Width="88" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
