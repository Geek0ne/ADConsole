<Window x:Class="ADConsole.Dialogs.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Icon="/app.ico"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重置密码"
        Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF0F4FA" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="UserLine" FontWeight="Bold" FontSize="13"/>
                <TextBlock x:Name="DnLine" FontSize="10" Foreground="#FF666666" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="新密码" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PwdBox" Grid.Row="2" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="GenBtn" Content="生成强密码" Click="GenBtn_Click"/>
            <CheckBox x:Name="ForceChangeBox" Content="下次登录时必须修改密码" IsChecked="True"
                      VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" TextWrapping="Wrap" FontSize="11" Foreground="#FF808080"
                   Text="提示：重置密码会立即生效，用户原密码同时失效。请通过安全渠道将新密码告知用户。"/>

        <TextBlock x:Name="Hint" Grid.Row="5" Foreground="#FFC00000" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkBtn" Content="重置" Width="100" IsDefault="True" Click="OkBtn_Click"/>
            <Button Content="取消" Width="88" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
