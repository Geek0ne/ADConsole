<Window x:Class="ADConsole.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD 域控管理控制台 — 登录"
        Height="400" Width="400"
        Icon="/app.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White">
        <Grid>
            <StackPanel Width="280" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- 标题 -->
                <TextBlock Text="AD 域控管理控制台" FontSize="19" FontWeight="Bold"
                           Foreground="#FF1F3864" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="Hint" Foreground="#FFC00000" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,2,0,10" TextWrapping="Wrap"/>

                <!-- 域 -->
                <TextBlock Text="域 (DNS 名称)" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                <TextBox x:Name="DomainBox" Margin="0,0,0,10"/>

                <!-- 账号 -->
                <TextBlock Text="账户名" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                <TextBox x:Name="UserBox" Margin="0,0,0,10" ToolTip="只填用户名即可，不需要带域名前缀"/>

                <!-- 密码 -->
                <TextBlock Text="密码" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                <PasswordBox x:Name="PwdBox" Margin="0,0,0,12"/>

                <!-- 选项 -->
                <CheckBox x:Name="RememberBox" Content="记住密码" Margin="0,0,0,4"
                          Checked="RememberBox_Changed" Unchecked="RememberBox_Changed"/>
                <CheckBox x:Name="AutoLoginBox" Content="自动登录（下次启动直接进入）"
                          Margin="0,0,0,14" IsEnabled="False"/>

                <!-- 按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="LoginBtn" Content="登 录" Width="96" Margin="0" IsDefault="True" Click="LoginBtn_Click"/>
                    <Button x:Name="CancelBtn" Content="退出" Width="80" IsCancel="True" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- 提示行 -->
                <TextBlock Margin="0,16,0,0" FontSize="11" Foreground="#FF808080"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Text="凭据使用 Windows DPAPI 加密后保存在当前 Windows 账户下，其他账户或机器无法解密。所有写操作均需具备相应权限的域账户。"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
