<Window x:Class="ADConsole.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD 域控管理控制台 — 登录"
        Height="396" Width="390"
        Icon="/app.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White">
        <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- 标题 -->
            <TextBlock Text="AD 域控管理控制台" FontSize="19" FontWeight="Bold"
                       Foreground="#FF1F3864" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Name="Hint" Foreground="#FFC00000" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"/>

            <!-- 表单：左列标签右对齐，右列输入框（宽 190），整块水平居中 -->
            <Grid Margin="0,16,0,0" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 域 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="域 (DNS 名称)"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox x:Name="DomainBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                <!-- 账号 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="账户名"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox x:Name="UserBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                         ToolTip="只填用户名即可，不需要带域名前缀"/>

                <!-- 密码 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="密码"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <PasswordBox x:Name="PwdBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"/>

                <!-- 选项（与输入框左对齐） -->
                <CheckBox x:Name="RememberBox" Grid.Row="3" Grid.Column="1" Content="记住密码"
                          Margin="0,0,0,4"
                          Checked="RememberBox_Changed" Unchecked="RememberBox_Changed"/>
                <CheckBox x:Name="AutoLoginBox" Grid.Row="4" Grid.Column="1"
                          Content="自动登录（下次启动直接进入）"
                          Margin="0,0,0,12" IsEnabled="False"/>

                <!-- 按钮（与输入框左对齐） -->
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="LoginBtn" Content="登 录" Width="96" Margin="0" IsDefault="True" Click="LoginBtn_Click"/>
                    <Button x:Name="CancelBtn" Content="退出" Width="80" IsCancel="True" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 提示行 -->
            <TextBlock Margin="0,16,0,0" FontSize="11" Foreground="#FF808080"
                       TextWrapping="Wrap" TextAlignment="Center" Width="320"
                       Text="凭据使用 Windows DPAPI 加密后保存在当前 Windows 账户下，其他账户或机器无法解密。所有写操作均需具备相应权限的域账户。"/>
        </StackPanel>
    </Border>
</Window>
