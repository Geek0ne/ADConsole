<Application x:Class="ADConsole.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- 程序图标（窗口标题栏 / Alt-Tab 用） -->
        <BitmapImage x:Key="AppIcon" UriSource="app.ico"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2D6CDF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFD0D0D0"/>
        <!-- 菜单悬停立即展开子菜单（Framework 4.8 没有 Menu.ShowDelay，
             默认要等约 400ms，这里用 MouseEnter 直接打开绕过延迟） -->
        <Style TargetType="MenuItem">
            <EventSetter Event="MouseEnter" Handler="MenuItem_InstantExpand"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
